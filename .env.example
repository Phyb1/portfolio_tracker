# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=False
ALLOWED_HOSTS=portfolio.phyb.co.zw,www.portfolio.phyb.co.zw

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# If deploying under a cPanel subdirectory, set these to include the prefix,
# e.g. STATIC_URL=/portfolio/static/  -- see README "cPanel static files".
STATIC_URL=static/
MEDIA_URL=media/

SITE_DOMAIN=portfolio.phyb.co.zw

TRIAL_PERIOD_DAYS=30
SUBSCRIPTION_PRICE_USD=5.00
SUBSCRIPTION_PERIOD_DAYS=90

ECOCASH_RECEIVE_NUMBER=07xxxxxxxx
ECOCASH_RECEIVE_NAME=PHYB
WHATSAPP_BUSINESS_NUMBER=2637xxxxxxxx

PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RETURN_URL=https://portfolio.phyb.co.zw/billing/paynow/return/
PAYNOW_RESULT_URL=https://portfolio.phyb.co.zw/billing/paynow/result/

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.phyb.co.zw
EMAIL_PORT=587
EMAIL_HOST_USER=alerts@phyb.co.zw
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=alerts@phyb.co.zw
